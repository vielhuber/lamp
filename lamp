#!/usr/bin/env bash
set -euo pipefail

directory=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
command=${1:-help}
if (( $# )); then shift; fi
json=false
if [[ "$command" = status || "$command" = version ]] && [[ "${1:-}" = --json ]]; then json=true; shift; fi
if [[ "$command" = help || "$command" = --help || "$command" = -h ]]; then
    printf '%s\n' 'Usage: lamp start|add|stop|restart|status [--json]|version [--json]|build <id|subdomain>|syncdb <profile>|list [--search <term>]|show <id|subdomain>|branch|exec [<id|subdomain>] "<command>"|curl|access <id|subdomain>|remove <id|subdomain>|ssh [<id|subdomain>]|cloudflare-setup|docker-build|docker-setup|docker-reset' \
        'docker-setup creates .data with a commented config/settings.yaml, a config/env.yaml with phpmyadmin, example files for syncdb and build scripts, and docker/docker-compose.override.yml with the projects mount; existing files are kept.' \
        'cloudflare-setup creates or verifies the tunnel, the wildcard dns record, the Access application with its policies, the service token and the cache bypass rule with cloudflare.token from settings.yaml.' \
        'build <id|subdomain> reruns the configured build of an existing environment inside the running container; docker-build rebuilds the image without layer cache.' \
        'syncdb <profile> runs a .data/syncdb profile unchanged inside the container; its target must point at the container databases (localhost, root, database.password).' \
        'list --search <term> returns only environments whose values contain the term (case-insensitive).' \
        'add [--git <repository>] [--id <12-hex-id>] [--branch <branch>] [--base-branch <branch>] [--php <version>] [--vpn <profile>] [--build <command>] [--subdomain <label>] [--directory <name>] [--db-name <name>] [--db-engine mysql|postgres|sqlite] [--alias <suffix> ...] [--webroot <directory>] [--proxy-port <port>] [--proxy-exclude <path>] [--visibility private|public]' \
        'exec [<id|subdomain>] "<command>": with an id or subdomain inside that environment (project directory, its php, database variables, authenticated curl), without an id as root in the container.' \
        'ssh [<id|subdomain>]: interactive root shell; with an environment it starts in the project directory with its variables and shows git status first.' \
        'branch <id|subdomain> <branch> [--base <branch>] [--operation switch|rename]' \
        'curl <id|subdomain> -- <curl arguments>; access <id|subdomain> (secret JSON for trusted integrations only)' \
        'Visibility defaults to private; public creates a hostname-specific Cloudflare Access bypass.' \
        'Each --alias adds <subdomain-or-id>-<suffix>.<domain> to the same environment; show includes all URLs.' \
        'Without --build, .data/build/<host>-<repository-path-with-hyphens>.sh is used if it exists.' \
        'For isolated database imports, use --build "syncdb <profile> && <setup commands>".' \
        'WARNING: docker-reset requires a stopped container and removes the containers AND ALL Compose volumes before rebuilding without layer cache; docker-build keeps the volumes.'
    exit 0
fi
case "$command" in
    docker-setup|docker-build|docker-reset|cloudflare-setup|start|restart|stop|status|version) test "$#" -eq 0 ;;
    ssh) test "$#" -le 1 ;;
    build) test "$#" -eq 1 ;;
    syncdb) test "$#" -eq 1 ;;
    list) test "$#" -eq 0 || [[ "$#" = 2 && "$1" = --search ]] ;;
    remove|show|access) test "$#" -eq 1 ;;
    exec) test "$#" -ge 1 && test "$#" -le 2 ;;
    curl|branch) ;;
    add) ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; exit 2 ;;
esac
if [[ "$command" = docker-setup ]]; then
    data="$directory/.data"
    preset() {
        local path=$1 mode=$2
        if [[ -e "$path" ]]; then
            cat > /dev/null
            printf 'kept    %s\n' "${path#"$directory/"}"
            return
        fi
        (umask 077; cat > "$path")
        chmod "$mode" "$path"
        printf 'created %s\n' "${path#"$directory/"}"
    }
    mkdir -p "$data" "$data/config" "$data/build" "$data/syncdb" "$data/ssh" "$data/cloudflare" "$data/vpn" "$directory/docker"
    chmod 700 "$data" "$data/config" "$data/build" "$data/syncdb" "$data/ssh" "$data/cloudflare" "$data/vpn"
    preset "$data/config/settings.yaml" 600 <<'PRESET'
# base domain of every environment: https://<subdomain-or-id>.<domain>
domain: example.com

# optional: git identity for commits made inside the container
# git:
#     name: Your Name
#     email: you@example.com

# optional: apache ServerAdmin (default: webmaster@localhost)
# apache:
#     admin: you@example.com

# optional: postfix hostname (default: lamp.localdomain) and an authenticated smtp relay (default: direct delivery)
# postfix:
#     hostname: mail.example.com
#     relayhost: '[smtp.example.com]:587'
#     username: '<USER>'
#     password: '<PASSWORD>'

# cloudflare api token (Account: Cloudflare Tunnel Edit, Access: Apps and Policies Edit, Access: Service Tokens Edit; Zone: Zone Read, DNS Edit, Cache Rules Edit)
# and the login email allowed by cloudflare access; applied by ./lamp cloudflare-setup
cloudflare:
    token: '<TOKEN>'
    email: you@example.com

# xdebug module for every php version; false keeps requests about 15 percent faster, true loads it in trigger mode for the browser extension and XDEBUG_TRIGGER
php:
    xdebug: false

# optional: password of mysql root and postgres, applied on every start; default: generated once per installation
# database:
#     password: '<PASSWORD>'

# optional: vpn tunnels; profiles live in .data/vpn/, names are lowercase, at most twelve characters, letter first
# vpn:
#     enabled: true
#     tunnels:
#         - name: office
#           type: openvpn
#           config: /etc/lamp/vpn/office.ovpn
#           username: '<USER>'
#           password: '<PASSWORD>'
#           routes: [192.168.50.0/24]
#           hosts:
#               internal.example.com: 192.168.50.10
#         - name: wg
#           type: wireguard
#           config: /etc/lamp/vpn/wg.conf
PRESET
    preset "$data/config/env.yaml" 600 <<'PRESET'
# static environments, one entry per project; lamp add --subdomain appends, lamp remove deletes, start/restart reconciles.
# an entry and a running environment are the same when every value matches. dynamic environments are not listed here.
# - git: git@github.com:<owner>/<project>.git
#   branch: null
#   subdomain: project
#   aliases: [shop, blog]
#   directory: project
#   db_name: project
#   db_engine: mysql
#   webroot: public
#   php: '8.5'
#   vpn: null
#   proxy_port: null
#   proxy_exclude: null
#   visibility: private
#   build: 'syncdb project-production-local && composer install'

# phpmyadmin with automatic root login behind cloudflare access; built by .data/build/github.com-phpmyadmin-phpmyadmin.sh
- git: https://github.com/phpmyadmin/phpmyadmin.git
  branch: STABLE
  subdomain: phpmyadmin
  directory: phpmyadmin
  db_name: null
  db_engine: null
  webroot: null
  vpn: null
  proxy_port: null
  proxy_exclude: null
  visibility: private
PRESET
    preset "$data/syncdb/example-production-local.json" 600 <<'PRESET'
{
    "engine": "mysql",
    "source": {
        "host": "127.0.0.1",
        "port": "3306",
        "database": "project",
        "username": "project",
        "password": "<PASSWORD>",
        "cmd": "mysql",
        "ssh": {
            "host": "example.com",
            "username": "deploy",
            "key": "~/.ssh/id_rsa"
        }
    },
    "target": {
        "host": "localhost",
        "port": "3306",
        "database": "project",
        "username": "root",
        "password": "<PASSWORD>",
        "ssh": false,
        "cmd": "mysql"
    },
    "replace": {
        "https://www.example.com": "https://project.example.com"
    }
}
PRESET
    preset "$data/build/github.com-owner-project.sh" 600 <<'PRESET'
#!/usr/bin/env bash
set -euo pipefail
syncdb example-production-local
test -f .env || cat > .env <<'LAMP_ENV'
APP_URL=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
LAMP_ENV
for key in APP_URL DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD; do
    sed -i "s|^$key=.*|$key=${!key}|" .env
done
composer install --no-interaction
npm install
npm run prod
PRESET
    preset "$data/build/github.com-phpmyadmin-phpmyadmin.sh" 600 <<'PRESET'
#!/usr/bin/env bash
set -euo pipefail
composer install --no-dev --no-interaction
yarn install --frozen-lockfile --non-interactive
mkdir -p tmp
php <<'PHP' > config.inc.php
<?php
$password = rtrim(file_get_contents('/var/lib/lamp/secrets/database-password'), "\r\n");
echo "<?php\n";
echo '$cfg[\'blowfish_secret\'] = ' . var_export(bin2hex(random_bytes(16)), true) . ";\n";
echo '$cfg[\'Servers\'][1][\'auth_type\'] = \'config\';' . "\n";
echo '$cfg[\'Servers\'][1][\'host\'] = \'localhost\';' . "\n";
echo '$cfg[\'Servers\'][1][\'user\'] = \'root\';' . "\n";
echo '$cfg[\'Servers\'][1][\'password\'] = ' . var_export($password, true) . ";\n";
echo '$cfg[\'ExecTimeLimit\'] = 6000;' . "\n";
PHP
chmod 600 config.inc.php
PRESET
    preset "$directory/docker/docker-compose.override.yml" 644 <<'PRESET'
# host-specific settings, ignored by git.
services:
    app:
        volumes:
            # projects directory; environments report container paths, so keep host and container path identical
            - type: bind
              source: /var/www
              target: /var/www
              bind:
                  create_host_path: false
            # additional read-only data used by a project, for example a photo collection:
            # - type: bind
            #   source: /path/on/host
            #   target: /path/on/host
            #   read_only: true
            #   bind:
            #       create_host_path: false
PRESET
    printf '%s\n' 'next: set domain, cloudflare.token and cloudflare.email in .data/config/settings.yaml, then ./lamp cloudflare-setup and ./lamp start'
    exit 0
fi
if [[ "$command" = docker-build || "$command" = docker-reset || "$command" = start || "$command" = restart ]]; then
    mkdir -p "$directory/.logs"
    chmod 700 "$directory/.logs"
    log_file=$(mktemp "$directory/.logs/$command-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX.log")
    exec 3>&1 4>&2
    exec > >(sed -u $'s/\033\\[[0-?]*[ -/]*[@-~]//g;s/\r/\\n/g' | tee -a "$log_file" >&3) 2>&1
    log_process=$!
    finish_log() {
        local result=$1 logs_result
        trap - EXIT INT TERM
        set +e
        if [[ -v start_since ]]; then
            printf "\nContainer startup output:\n"
            "${compose[@]}" logs --no-color --timestamps --since "$start_since" app
            logs_result=$?
            if [[ "$result" = 0 && "$logs_result" != 0 ]]; then result=$logs_result; fi
            "${compose[@]}" ps --all
        fi
        printf "\n[%s] %s finished (exit %s, elapsed %ss)\n" "$(date -u +%FT%TZ)" "$command" "$result" "$SECONDS"
        exec 1>&3 2>&4 3>&- 4>&-
        wait "$log_process"
        logs_result=$?
        if [[ "$logs_result" != 0 ]]; then
            printf "Could not finish writing log: %s\n" "$log_file" >&2
            if [[ "$result" = 0 ]]; then result=$logs_result; fi
        fi
        exit "$result"
    }
    trap 'finish_log $?' EXIT
    trap 'finish_log 130' INT
    trap 'finish_log 143' TERM
    printf '[%s] %s started\nLog: %s\n' "$(date -u +%FT%TZ)" "$command" "$log_file"
fi
export LAMP_DATA_DIR="$directory/.data"
# interactive calls get a terminal inside the container (progress bars); piped calls stay plain
tty=(-T)
if [[ -t 0 && -t 1 ]]; then tty=(); fi
compose=(docker compose --ansi never --progress plain --project-directory "$directory/docker" -f "$directory/docker/docker-compose.yml")
if [[ -f "$directory/docker/docker-compose.override.yml" ]]; then
    compose+=(-f "$directory/docker/docker-compose.override.yml")
fi
if [[ "$command" = status || "$command" = version ]]; then
    if $json; then
        container_id=$("${compose[@]}" ps --all --quiet app)
        state=missing
        health=unknown
        if [[ -n "$container_id" ]]; then
            state=$(docker inspect --format '{{.State.Status}}' "$container_id")
            health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}unknown{{end}}' "$container_id")
        fi
        python3 -c 'import json,sys; print(json.dumps(dict(root=sys.argv[1],state=sys.argv[2],healthy=sys.argv[3]=="healthy",api=1)))' "$directory" "$state" "$health"
        exit 0
    fi
    printf 'LAMP\nCheckout: %s\n' "$directory"
    if [[ "$command" = version ]]; then
        revision=$(git -C "$directory" describe --tags --always --dirty 2>/dev/null) || revision='unknown (Git metadata unavailable)'
        printf 'Source version: %s\n' "$revision"
    fi
    if ! container_id=$("${compose[@]}" ps --all --quiet app); then
        printf 'Container information unavailable: Docker/Compose query failed.\n' >&2
        exit 1
    fi
    if [[ -z "$container_id" ]]; then
        printf 'Container: not created\n'
        if [[ "$command" = version ]]; then printf 'Container image: unavailable (no container)\n'; fi
        exit 0
    fi
    if [[ "$command" = version ]]; then
        docker inspect --type container --format 'Container image: {{.Image}}' "$container_id"
        exit 0
    fi
    "${compose[@]}" ps --all app
    container_state=$(docker inspect --type container --format '{{.State.Status}}' "$container_id")
    if [[ "$container_state" != running ]]; then
        printf '\nServices: not queried (container %s)\n' "$container_state"
        exit 0
    fi
    printf '\nServices:\n'
    service_result=0
    "${compose[@]}" exec -T app supervisorctl status || service_result=$?
    if [[ "$service_result" != 0 && "$service_result" != 3 ]]; then exit "$service_result"; fi
    exit 0
fi
mkdir -p "$LAMP_DATA_DIR/config" "$LAMP_DATA_DIR/ssh" "$LAMP_DATA_DIR/syncdb" "$LAMP_DATA_DIR/build"
chmod 700 "$LAMP_DATA_DIR" "$LAMP_DATA_DIR/config" "$LAMP_DATA_DIR/ssh" "$LAMP_DATA_DIR/syncdb" "$LAMP_DATA_DIR/build"
if [[ ! -f "$LAMP_DATA_DIR/config/settings.yaml" || ! -f "$directory/docker/docker-compose.override.yml" ]]; then
    printf '%s\n' 'Missing .data/config/settings.yaml or docker/docker-compose.override.yml. Run ./lamp docker-setup first.' >&2
    exit 1
fi
# environments belong to www-data while harnesses run as root on the host
if [[ "$command" = start || "$command" = add ]] && ! git config --global --get-all safe.directory | grep -qx '\*'; then
    git config --global --add safe.directory '*'
fi
case "$command" in
    build|syncdb|docker-build|docker-reset|start|restart|stop|add|remove)
        lock_identity=$(printf '%s' "$directory" | sha256sum)
        exec 9>> "/tmp/lamp-${lock_identity%% *}.lock"
        flock 9
        ;;
esac
case "$command" in
    docker-build|docker-reset|start|restart|stop)
        container_state=$("${compose[@]}" ps --all --format '{{.State}}' app)
        case "$container_state" in
            running|restarting|paused)
                if [[ "$command" != stop && "$command" != restart ]]; then
                    printf 'Cannot %s: LAMP is already active. Run lamp stop first.\n' "$command" >&2
                    exit 1
                fi
                ;;
            ''|created|exited|dead)
                if [[ "$command" = stop ]]; then
                    printf 'Cannot stop: LAMP is not running.\n' >&2
                    exit 1
                fi
                ;;
            *) printf 'Cannot %s: unexpected LAMP container state (%s).\n' "$command" "$container_state" >&2; exit 1 ;;
        esac
        ;;
esac
case "$command" in
    docker-build) "${compose[@]}" build --no-cache ;;
    docker-reset)
        terminal_type=${TERM:-xterm}
        if [[ "$terminal_type" = dumb ]]; then terminal_type=xterm; fi
        TERM="$terminal_type" clear >&3 && "${compose[@]}" down --volumes && "${compose[@]}" build --no-cache
        ;;
    start|restart)
        if [[ "$command" = restart && "$container_state" = running ]]; then
            "${compose[@]}" exec -T app python3 /opt/lamp/vpn.py validate
            "${compose[@]}" exec -T app python3 /opt/lamp/control.py validate
        fi
        if [[ "$command" = restart ]]; then "${compose[@]}" stop; fi
        start_since=$(date -u +%FT%TZ)
        "${compose[@]}" up -d --no-build --wait --wait-timeout 240
        "${compose[@]}" exec -T app python3 /opt/lamp/control.py reconcile
        ;;
    stop) "${compose[@]}" stop ;;
    ssh)
        if [[ "$#" = 1 ]]; then
            identity=$("${compose[@]}" exec -T app python3 /opt/lamp/control.py show "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin)["id"])')
            "${compose[@]}" exec app bash -c "source /var/lib/lamp/environments/$identity/setup.env && cd \"\$LAMP_PROJECT_DIR\" && git status; exec bash -il"
        else
            "${compose[@]}" exec app bash -il
        fi
        ;;
    cloudflare-setup) "${compose[@]}" run --rm --no-deps -T app python3 /opt/lamp/cloudflare.py setup ;;
    exec)
        if [[ "$#" = 2 ]]; then
            "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py exec "$1" "$2"
        else
            "${compose[@]}" exec "${tty[@]}" app bash -lc "$1"
        fi
        ;;
    curl)
        "${compose[@]}" exec -T app python3 /opt/lamp/curl.py "$@"
        ;;
    syncdb) "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py sync "$@" ;;
    *) "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py "$command" "$@" ;;
esac
