#!/usr/bin/env bash
set -euo pipefail

DEPLOYMENT_SCRIPT_VERSION=3
directory=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
if [[ ! -e "$directory/.git" && "${LAMP_DEPLOYMENT_REFRESHED:-0}" != 1 && "${1:-}" != presets ]] \
    && command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 \
    && docker image inspect ghcr.io/vielhuber/lamp:latest >/dev/null 2>&1; then
    if deployment_container=$(docker create ghcr.io/vielhuber/lamp:latest) && [[ -n "$deployment_container" ]]; then
        deployment_directory=$(mktemp -d "$directory/.lamp-update.XXXXXXXX")
        trap 'docker rm "$deployment_container" >/dev/null; rm -rf -- "$deployment_directory"' EXIT
        deployment_changed=false
        if docker cp "$deployment_container:/app/lamp" "$deployment_directory/lamp" >/dev/null 2>&1; then
            candidate_version=$(sed -n 's/^DEPLOYMENT_SCRIPT_VERSION=\([0-9][0-9]*\)$/\1/p' "$deployment_directory/lamp")
            if [[ "$candidate_version" =~ ^[0-9]+$ ]] && (( candidate_version >= DEPLOYMENT_SCRIPT_VERSION )) \
                && bash -n "$deployment_directory/lamp" 2>/dev/null; then
                mkdir -p "$deployment_directory/docker/scripts"
                if docker cp "$deployment_container:/app/docker/docker-compose.yml" "$deployment_directory/docker/docker-compose.yml" >/dev/null 2>&1 \
                    && docker cp "$deployment_container:/app/docker/docker-compose.data.yml" "$deployment_directory/docker/docker-compose.data.yml" >/dev/null 2>&1 \
                    && docker cp "$deployment_container:/opt/lamp/vscode.py" "$deployment_directory/docker/scripts/vscode.py" >/dev/null 2>&1; then
                    deployment_files=(docker/docker-compose.yml docker/docker-compose.data.yml docker/scripts/vscode.py lamp)
                    for deployment_file in "${deployment_files[@]}"; do
                        if ! cmp -s "$deployment_directory/$deployment_file" "$directory/$deployment_file"; then deployment_changed=true; fi
                    done
                    if [[ "$deployment_changed" = true ]]; then
                        chmod 755 "$deployment_directory/lamp"
                        mkdir -p "$directory/docker/scripts"
                        for deployment_file in "${deployment_files[@]}"; do
                            mv -f -- "$deployment_directory/$deployment_file" "$directory/$deployment_file"
                        done
                    fi
                else
                    printf '%s\n' '⚠️ Could not refresh the LAMP host files; keeping the current installation.' >&2
                fi
            fi
        fi
        docker rm "$deployment_container" >/dev/null
        rm -rf -- "$deployment_directory"
        trap - EXIT
        if [[ "$deployment_changed" = true ]]; then
            printf '%s\n' '📦 LAMP host files updated from the local image.' >&2
            exec env LAMP_DEPLOYMENT_REFRESHED=1 "$directory/lamp" "$@"
        fi
    fi
fi
command=${1:-help}
if (( $# )); then shift; fi
json=false
if [[ "$command" = status || "$command" = version ]] && [[ "${1:-}" = --json ]]; then json=true; shift; fi
if [[ "$command" = help || "$command" = --help || "$command" = -h ]]; then
    printf '%s\n' 'Usage: lamp start|add|stop|restart|status [--json]|version [--json]|build [<id|subdomain>]|syncdb <profile>|list [--search <term>]|show <id|subdomain>|branch|exec [<id|subdomain>] "<command>"|curl|access <id|subdomain>|remove <id|subdomain>|reset|audit|code|ssh [<id|subdomain>]|cloudflare-setup|docker-build|docker-setup|presets|docker-reset' \
        'docker-setup is run by the first start of a new installation: it asks for the domain, an optional private data repository and whether to add phpmyadmin, creates .config with setup.yaml and env.yaml, docker/docker-compose.override.yml with the projects mount and, without a data repository, .data with a commented settings.yaml and example files for syncdb and build scripts; with a data repository it tries host SSH access first and asks for a private key only if that fails; existing files are kept.' \
        'reset removes every dynamic environment with its checkout under _environments and its isolated databases; static environments stay. docker-reset is something else: it deletes all volumes.' \
        'presets writes the boilerplate .config/env.yaml and docker/docker-compose.override.yml when they are missing; init runs it.' \
        'The final setup question can generate initial environments from existing Git checkouts (default /var/www); registered directories stay, new entries use main and private visibility. Static environments only run build scripts on explicit lamp build requests, never during start/restart or initial registration.' \
        'cloudflare-setup creates or verifies the tunnel, the wildcard dns record, the Access application with its policies, the service token and the cache bypass rule with cloudflare.token from settings.yaml.' \
        'build [<id|subdomain>] reruns the configured build inside the running container; without an argument it selects the environment containing the current directory; docker-build rebuilds the image without layer cache.' \
        'syncdb <profile> runs a .data/syncdb profile unchanged inside the container; its target must point at the container databases (localhost, root, database.password).' \
        'list --search <term> returns only environments whose values contain the term (case-insensitive).' \
        'add [--git <repository>] [--id <12-hex-id>] [--branch <branch>] [--base-branch <branch>] [--php <version>] [--vpn <profile>] [--build <command>] [--restore-worktree-after-build] [--subdomain <label>] [--directory <name>] [--db-name <name>] [--db-engine mysql|postgres|sqlite] [--alias <suffix> ...] [--webroot <directory>] [--proxy-port <port>] [--proxy-exclude <path>] [--visibility private|public]' \
        '--restore-worktree-after-build restores tracked files and the index only after a successful initial build of a freshly cloned, clean dynamic environment. It is not persisted; build, existing checkouts and failed builds never restore files. Untracked and ignored files stay.' \
        'exec [<id|subdomain>] "<command>": with an id or subdomain inside that environment (project directory, its php, database variables, authenticated curl), without an id as root in the container.' \
        'audit: check /var/www inside the container for missing GitHub repositories, folders without Git, static LAMP environments, dependency/runtime versions and Git changes; clean repositories with remote changes are pulled with --ff-only.' \
        'code: run code . in the current directory inside the running container and open the host VS Code attached to it.' \
        'ssh [<id|subdomain>]: interactive root shell in the current host directory when it exists in the container; with an environment it starts in the project directory with its variables and shows git status first when .git exists.' \
        'branch <id|subdomain> <branch> [--base <branch>] [--operation switch|rename]' \
        'curl <id|subdomain> -- <curl arguments>; access <id|subdomain> (secret JSON for trusted integrations only)' \
        'Visibility defaults to private; public creates a hostname-specific Cloudflare Access bypass.' \
        'Each --alias adds <subdomain-or-id>-<suffix>.<domain> to the same environment; show includes all URLs.' \
        'Without --build, .data/build/<host>-<repository-path-with-hyphens>.sh is used if it exists.' \
        'For isolated database imports, use --build "syncdb <profile> && <setup commands>".' \
        'WARNING: docker-reset automatically stops and removes the containers, ALL Compose volumes and service images; it does not rebuild. docker-build keeps the volumes.'
    exit 0
fi
arguments_valid=true
case "$command" in
    docker-setup|presets|docker-build|docker-reset|cloudflare-setup|start|restart|stop|reset|status|version|audit|code) (( $# == 0 )) || arguments_valid=false ;;
    ssh|build) (( $# <= 1 )) || arguments_valid=false ;;
    syncdb|remove|show|access) (( $# == 1 )) || arguments_valid=false ;;
    list) (( $# == 0 )) || [[ "$#" = 2 && "$1" = --search ]] || arguments_valid=false ;;
    exec) (( $# >= 1 && $# <= 2 )) || arguments_valid=false ;;
    curl|branch) ;;
    add) ;;
    *) printf '❌ Unknown command: %s; see ./lamp help\n' "$command" >&2; exit 2 ;;
esac
if [[ "$arguments_valid" = false ]]; then printf '❌ Wrong arguments for %s; see ./lamp help\n' "$command" >&2; exit 2; fi
if [[ "$command" = build && $# == 0 ]]; then set -- --directory "$PWD"; fi
compose=(docker compose --ansi never --progress plain --project-directory "$directory/docker" -f "$directory/docker/docker-compose.yml")
require_docker() {
    if docker info > /dev/null 2>&1; then return; fi
    printf '%s\n' '❌ Docker is unavailable. Start Docker Desktop or the Docker daemon and retry.' >&2
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        printf '👉 Docker Desktop → Settings → Resources → WSL Integration: enable "%s", then Apply.\n' "$WSL_DISTRO_NAME" >&2
    fi
    return 1
}
configured_data_repository() {
    local value
    value=$(sed -n 's/^data:[[:space:]]*//p' "$directory/.config/setup.yaml" | sed "s/[[:space:]]*\(#.*\)\?$//; s/^[\"']//; s/[\"']$//")
    if [[ "$value" = null || "$value" = '~' ]]; then value=; fi
    printf '%s' "$value"
}
# with a data repository /etc/lamp is a clone inside the container (state volume), mirrored from the repository afterwards
read_data_key() {
    local line
    if ! { : < /dev/tty; } 2> /dev/null; then
        printf '❌ The first clone of %s needs a terminal to ask for a private ssh key.\n' "$data_repository" >&2
        exit 1
    fi
    stty -echo < /dev/tty
    printf 'Private ssh key that may read %s (paste it; the input stays hidden, is used once and not stored): ' "$data_repository" > /dev/tty
    data_key=
    while IFS= read -r line < /dev/tty; do
        data_key+="$line"$'\n'
        if [[ "$line" = -----END*PRIVATE\ KEY----- ]]; then break; fi
    done
    stty echo < /dev/tty
    printf 'received\n' > /dev/tty
}
sync_data() {
    local in_container data_result
    require_docker
    # a one-off container sees the mounts of the next start; build, syncdb and add need the running container anyway
    in_container=("${compose[@]}" run --rm --no-deps -T app)
    if [[ "$command" = build || "$command" = syncdb || "$command" = add ]]; then in_container=("${compose[@]}" exec -T app); fi
    data_result=0
    "${in_container[@]}" bash -c 'set -euo pipefail
        if [[ ! -d /var/lib/lamp/data/.git ]]; then exit 3; fi
        export GIT_SSH_COMMAND="ssh -i /var/lib/lamp/data/ssh/id_rsa -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/var/lib/lamp/data/ssh/known_hosts"
        for attempt in {1..5}; do
            if git -C /var/lib/lamp/data fetch --quiet origin; then break; fi
            if (( attempt == 5 )); then exit 4; fi
            printf "⚠️ data fetch failed (attempt %s/5); retrying in 5 seconds\n" "$attempt" >&2
            sleep 5
        done
        git -C /var/lib/lamp/data reset --quiet --hard "@{upstream}"
        # git keeps no private modes; ssh refuses keys that others can read
        chmod -R go= /var/lib/lamp/data' < /dev/null || data_result=$?
    if [[ "$data_result" = 4 ]]; then
        printf '❌ The data repository %s could not be fetched after 5 attempts; aborting.\n' "$data_repository" >&2
    elif [[ "$data_result" = 0 && ( "$command" = start || "$command" = restart ) ]]; then
        printf '📦 data is up to date with %s\n' "$data_repository"
    fi
    if [[ "$data_result" = 3 ]]; then
        data_result=0
        (
            umask 077
            data_checkout=$(mktemp -d) || exit 1
            trap 'rm -rf -- "$data_checkout"' EXIT
            printf '📥 cloning %s with host SSH access\n' "$data_repository"
            GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o StrictHostKeyChecking=accept-new" \
                git clone --progress -- "$data_repository" "$data_checkout/data" || exit 3
            printf '📦 transferring data repository into the container\n'
            tar -C "$data_checkout/data" -cf - . | "${in_container[@]}" bash -c 'set -euo pipefail
                umask 077
                mkdir -p /var/lib/lamp/data
                tar -xf - -C /var/lib/lamp/data
                chmod -R go= /var/lib/lamp/data' || exit 1
        ) || data_result=$?
        if [[ "$data_result" = 3 ]]; then
            read_data_key
            data_result=0
            printf '%s' "$data_key" | "${in_container[@]}" bash -c 'set -euo pipefail
                umask 077
                trap "rm -f /dev/shm/lamp-data-key" EXIT
                cat > /dev/shm/lamp-data-key
                GIT_SSH_COMMAND="ssh -i /dev/shm/lamp-data-key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR" git clone --progress "$1" /var/lib/lamp/data
                chmod -R go= /var/lib/lamp/data' lamp "$data_repository" || data_result=$?
            data_key=
        fi
        if [[ "$data_result" != 0 ]]; then
            printf '❌ The data repository could not be cloned into the container.\n' >&2
            exit "$data_result"
        fi
        printf '📦 cloned %s\n' "$data_repository"
    elif [[ "$data_result" != 0 ]]; then
        exit "$data_result"
    fi
} >&2
preset() {
    local path=$1 mode=$2
    if [[ -e "$path" ]]; then
        cat > /dev/null
        printf '📝 kept %s\n' "${path#"$directory/"}"
        return
    fi
    (umask 077; cat > "$path")
    chmod "$mode" "$path"
    printf '📝 created %s\n' "${path#"$directory/"}"
}
# files of this host that can be edited before the first start; init writes them right away
write_presets() {
    mkdir -p "$directory/.config" "$directory/docker"
    chmod 700 "$directory/.config"
    preset "$directory/.config/env.yaml" 600 <<'PRESET'
# static environments, one entry per project; lamp add --subdomain appends, lamp remove deletes, start/restart reconciles.
# an entry and a running environment are the same when every value matches. dynamic environments are not listed here.
# - git: git@github.com:<owner>/<project>.git
#   branch: null
#   subdomain: project
#   aliases: [shop, blog]
#   directory: project
#   db_name: project
#   db_engine: mysql
#   webroot: public
#   php: '8.5'
#   vpn: null
#   proxy_port: null
#   proxy_exclude: null
#   visibility: private
#   build: 'syncdb project-production-local && composer install'

[]
PRESET
    preset "$directory/docker/docker-compose.override.yml" 644 <<'PRESET'
# host-specific settings, ignored by git.
services:
    app:
        volumes:
            # projects directory; environments report container paths, so keep host and container path identical
            - type: bind
              source: /var/www
              target: /var/www
              bind:
                  create_host_path: false
            # additional read-only data used by a project, for example a photo collection:
            # - type: bind
            #   source: /path/on/host
            #   target: /path/on/host
            #   read_only: true
            #   bind:
            #       create_host_path: false
PRESET
}
docker_setup() {
    data="$directory/.data"
    config="$directory/.config"
    domain=example.com
    data_repository=
    # a new installation is asked for its domain and its data repository; without a terminal the presets stay as they are
    if [[ -e "$config/setup.yaml" ]]; then
        data_repository=$(configured_data_repository)
    elif { : < /dev/tty; } 2> /dev/null; then
        read -r -p 'Domain of the environments (<domain> in https://<subdomain>.<domain>): ' domain < /dev/tty
        read -r -p 'Private git repository with the data of this instance (ssh url, empty for a local .data folder): ' data_repository < /dev/tty
        if [[ -n "$data_repository" && ! "$data_repository" =~ ^git@[A-Za-z0-9.-]+:[A-Za-z0-9_./-]+$ ]]; then
            printf '%s\n' '❌ The data repository must be an ssh url like git@github.com:<owner>/lamp-data.git.' >&2
            exit 2
        fi
    fi
    write_presets
    setup="domain: ${domain:-example.com}"
    if [[ -n "$data_repository" ]]; then setup+=$'\n\n'"data: $data_repository"; fi
    preset "$config/setup.yaml" 600 <<< "$setup"
    # with a data repository .data is a clone, so no presets are written into it
    if [[ -z "$data_repository" ]]; then
        mkdir -p "$data" "$data/build" "$data/syncdb" "$data/ssh" "$data/vpn"
        chmod 700 "$data" "$data/build" "$data/syncdb" "$data/ssh" "$data/vpn"
        preset "$data/settings.yaml" 600 <<'PRESET'
# optional: git identity for commits made inside the container; commit_* let `git commit` without a message write one through an openai compatible endpoint
# git:
#     name: Your Name
#     email: you@example.com
#     commit_key: sk-...
#     commit_url: https://api.openai.com/v1
#     commit_model: gpt-...
#     commit_effort: medium

# optional: apache ServerAdmin (default: webmaster@localhost)
# apache:
#     admin: you@example.com

# optional: postfix hostname (default: lamp.localdomain) and an authenticated smtp relay (default: direct delivery)
# postfix:
#     hostname: mail.example.com
#     relayhost: '[smtp.example.com]:587'
#     username: '<USER>'
#     password: '<PASSWORD>'
#     sender: noreply@example.com
# for Office365, use relayhost '[smtp.office365.com]:587', username noreply@example.com,
# and these three values instead of password (SMTP.SendAsApp and mailbox access required)
#     oauth_tenant_id: '<TENANT_UUID>'
#     oauth_client_id: '<CLIENT_UUID>'
#     oauth_client_secret: '<CLIENT_SECRET>'

# cloudflare api token (Account: Cloudflare Tunnel Edit, Access: Apps and Policies Edit, Access: Service Tokens Edit; Zone: Zone Read, DNS Edit, Cache Rules Edit)
# and the login email allowed by cloudflare access; applied by ./lamp cloudflare-setup
cloudflare:
    token: '<TOKEN>'
    email: you@example.com

# xdebug module for every php version; false keeps requests about 15 percent faster, true loads it in trigger mode for the browser extension and XDEBUG_TRIGGER
php:
    xdebug: false

# optional: github token for composer (private repositories, api rate limit), applied on every start
# composer:
#     github: '<TOKEN>'

# optional: password of mysql root and postgres, applied on every start; default: generated once per installation
# database:
#     password: '<PASSWORD>'

# optional: vpn tunnels; profiles live in .data/vpn/, names are lowercase, at most twelve characters, letter first
# vpn:
#     enabled: true
#     tunnels:
#         - name: office
#           type: openvpn
#           config: /etc/lamp/vpn/office.ovpn
#           username: '<USER>'
#           password: '<PASSWORD>'
#           routes: [192.168.50.0/24]
#           hosts:
#               internal.example.com: 192.168.50.10
#         - name: wg
#           type: wireguard
#           config: /etc/lamp/vpn/wg.conf
PRESET
        preset "$data/syncdb/example-production-local.json" 600 <<'PRESET'
{
    "engine": "mysql",
    "source": {
        "host": "127.0.0.1",
        "port": "3306",
        "database": "project",
        "username": "project",
        "password": "<PASSWORD>",
        "cmd": "mysql",
        "ssh": {
            "host": "example.com",
            "username": "deploy",
            "key": "~/.ssh/id_rsa"
        }
    },
    "target": {
        "host": "localhost",
        "port": "3306",
        "database": "project",
        "username": "root",
        "password": "<PASSWORD>",
        "ssh": false,
        "cmd": "mysql"
    },
    "replace": {
        "https://www.example.com": "https://project.example.com"
    }
}
PRESET
        preset "$data/build/github.com-owner-project.sh" 600 <<'PRESET'
#!/usr/bin/env bash
set -euo pipefail
syncdb example-production-local
test -f .env || cat > .env <<'LAMP_ENV'
APP_URL=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
LAMP_ENV
for key in APP_URL DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD; do
    sed -i "s|^$key=.*|$key=${!key}|" .env
done
composer install --no-interaction
npm install
npm run prod
PRESET
        preset "$data/build/github.com-phpmyadmin-phpmyadmin.sh" 600 <<'PRESET'
#!/usr/bin/env bash
set -euo pipefail
composer install --no-dev --no-interaction
yarn install --frozen-lockfile --non-interactive
mkdir -p tmp
php <<'PHP' > config.inc.php
<?php
$password = rtrim(file_get_contents('/var/lib/lamp/secrets/database-password'), "\r\n");
echo "<?php\n";
echo '$cfg[\'blowfish_secret\'] = ' . var_export(bin2hex(random_bytes(16)), true) . ";\n";
echo '$cfg[\'Servers\'][1][\'auth_type\'] = \'config\';' . "\n";
echo '$cfg[\'Servers\'][1][\'host\'] = \'localhost\';' . "\n";
echo '$cfg[\'Servers\'][1][\'user\'] = \'root\';' . "\n";
echo '$cfg[\'Servers\'][1][\'password\'] = ' . var_export($password, true) . ";\n";
echo '$cfg[\'ExecTimeLimit\'] = 6000;' . "\n";
PHP
chmod 600 config.inc.php
PRESET
    fi
    if [[ -n "$data_repository" ]]; then
        sync_data
        if [[ "$command" = docker-setup ]]; then printf '%s\n' '👉 next: ./lamp start'; fi
    else
        printf '%s\n' '👉 next: set cloudflare.token and cloudflare.email in .data/settings.yaml, then ./lamp start'
    fi
    if { : < /dev/tty; } 2> /dev/null; then
        read -r -p 'Set up phpMyAdmin? [y/N]: ' phpmyadmin < /dev/tty
        if [[ "${phpmyadmin,,}" = y || "${phpmyadmin,,}" = yes || "${phpmyadmin,,}" = j || "${phpmyadmin,,}" = ja ]]; then
            require_docker
            "${compose[@]}" --progress quiet run --rm --no-deps -T app yq -y --in-place '
                if any(.[]; .directory == "phpmyadmin" or
                    (.subdomain | if type == "array" then . else [.] end | index("phpmyadmin") != null))
                then . else . + [{git: "https://github.com/phpmyadmin/phpmyadmin.git", branch: "STABLE",
                    subdomain: "phpmyadmin", directory: "phpmyadmin", visibility: "private"}] end
            ' /etc/lamp-config/env.yaml
        fi
    fi
    if { : < /dev/tty; } 2> /dev/null && [[ ! -e "$config/initial-environments" ]]; then
        read -r -e -i /var/www -p 'Generate initial environments from folder (empty to skip): ' initial_folder < /dev/tty
        if [[ -n "$initial_folder" ]]; then
            initial_folder=$(realpath -e -- "$initial_folder")
            if [[ ! -d "$initial_folder" || ( "$initial_folder" != /var/www && "$initial_folder" != /var/www/* ) ]]; then
                printf '%s\n' '❌ Choose an existing folder under /var/www, mounted at the same path in the container.' >&2
                exit 2
            fi
            (umask 077; printf '%s\n' "$initial_folder" > "$config/initial-environments")
        fi
    fi
}
if [[ "$command" = docker-setup ]]; then
    docker_setup
    exit 0
fi
if [[ "$command" = presets ]]; then
    write_presets
    exit 0
fi
if [[ "$command" != status && "$command" != version ]]; then require_docker; fi
# the first start of a new installation asks the setup questions itself; without a data repository the settings have to be filled first
if [[ "$command" = start && ! -e "$directory/.config/setup.yaml" ]] && { : < /dev/tty; } 2> /dev/null; then
    docker_setup
    if [[ -z "$data_repository" ]]; then exit 0; fi
fi
if [[ "$command" = docker-build || "$command" = docker-reset || "$command" = start || "$command" = restart ]]; then
    mkdir -p "$directory/.logs"
    chmod 700 "$directory/.logs"
    log_file=$(mktemp "$directory/.logs/$command-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX.log")
    exec 3>&1 4>&2
    # start and restart show status lines and Git progress; the complete output goes to the log
    terminal_lines() {
        if [[ "$command" = start || "$command" = restart ]]; then
            LC_ALL=C grep --line-buffered -E '^(🚀|🐳|🌐|📥|🔨|📦|🔐|⚠️|✅|❌|👉|(remote: )?(Enumerating objects|Counting objects|Compressing objects|Receiving objects|Resolving deltas|Updating files|Checking out files|Filtering content|Updating index):)' || true
        else
            cat
        fi
    }
    exec > >(LC_ALL=C sed -u $'s/\033\\[[0-?]*[ -/]*[@-~]//g;s/\r/\\n/g' | tee -a "$log_file" | terminal_lines >&3) 2>&1
    log_process=$!
    finish_log() {
        local result=$1 logs_result
        trap - EXIT INT TERM
        set +e
        if [[ -v start_since ]]; then
            printf "\nContainer startup output:\n"
            "${compose[@]}" logs --no-color --timestamps --since "$start_since" app
            logs_result=$?
            if [[ "$result" = 0 && "$logs_result" != 0 ]]; then result=$logs_result; fi
            "${compose[@]}" ps --all
        fi
        printf "\n[%s] %s finished (exit %s, elapsed %ss)\n" "$(date -u +%FT%TZ)" "$command" "$result" "$SECONDS"
        if [[ "$result" = 0 ]]; then
            printf '✅ %s finished in %ss\n' "$command" "$SECONDS"
        else
            # a container that did not come up explains itself in its last lines
            if [[ "${phase:-}" = container ]]; then "${compose[@]}" logs --no-color --no-log-prefix --tail 5 app 2>&1 | sed 's/^/❌   /'; fi
            printf '❌ %s failed (exit %s) after %ss · full log: %s\n' "$command" "$result" "$SECONDS" "$log_file"
        fi
        exec 1>&3 2>&4 3>&- 4>&-
        wait "$log_process"
        logs_result=$?
        if [[ "$logs_result" != 0 ]]; then
            printf "❌ Could not finish writing log: %s\n" "$log_file" >&2
            if [[ "$result" = 0 ]]; then result=$logs_result; fi
        fi
        exit "$result"
    }
    trap 'finish_log $?' EXIT
    trap 'finish_log 130' INT
    trap 'finish_log 143' TERM
    printf '[%s] %s started\nLog: %s\n' "$(date -u +%FT%TZ)" "$command" "$log_file"
    if [[ "$command" = start ]]; then printf '🚀 starting lamp · full log: %s\n' "$log_file"; fi
    if [[ "$command" = restart ]]; then printf '🚀 restarting lamp · full log: %s\n' "$log_file"; fi
fi
export LAMP_CONFIG_DIR="$directory/.config"
# interactive calls get a terminal inside the container (progress bars); piped calls stay plain
tty=(-T)
if [[ -t 0 && -t 1 ]]; then tty=(); fi
if [[ -f "$directory/docker/docker-compose.override.yml" ]]; then
    compose+=(-f "$directory/docker/docker-compose.override.yml")
fi
if [[ "$command" = status || "$command" = version ]]; then
    if $json; then
        container_id=$("${compose[@]}" ps --all --quiet app)
        state=missing
        health=unknown
        if [[ -n "$container_id" ]]; then
            state=$(docker inspect --format '{{.State.Status}}' "$container_id")
            health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}unknown{{end}}' "$container_id")
        fi
        python3 -c 'import json,sys; print(json.dumps(dict(root=sys.argv[1],state=sys.argv[2],healthy=sys.argv[3]=="healthy",api=1)))' "$directory" "$state" "$health"
        exit 0
    fi
    printf 'LAMP\nCheckout: %s\n' "$directory"
    if [[ "$command" = version ]]; then
        revision=$(git -C "$directory" describe --tags --always --dirty 2>/dev/null) || revision='unknown (Git metadata unavailable)'
        printf 'Source version: %s\n' "$revision"
    fi
    if ! container_id=$("${compose[@]}" ps --all --quiet app); then
        printf '❌ Container information unavailable: Docker/Compose query failed.\n' >&2
        exit 1
    fi
    if [[ -z "$container_id" ]]; then
        printf 'Container: not created\n'
        if [[ "$command" = version ]]; then printf 'Container image: unavailable (no container)\n'; fi
        exit 0
    fi
    if [[ "$command" = version ]]; then
        docker inspect --type container --format 'Container image: {{.Image}}' "$container_id"
        exit 0
    fi
    "${compose[@]}" ps --all app
    container_state=$(docker inspect --type container --format '{{.State.Status}}' "$container_id")
    if [[ "$container_state" != running ]]; then
        printf '\nServices: not queried (container %s)\n' "$container_state"
        exit 0
    fi
    printf '\nServices:\n'
    service_result=0
    "${compose[@]}" exec -T app supervisorctl status || service_result=$?
    if [[ "$service_result" != 0 && "$service_result" != 3 ]]; then exit "$service_result"; fi
    exit 0
fi
data_repository=
if [[ "$command" != docker-reset ]]; then
    if [[ ! -f "$LAMP_CONFIG_DIR/setup.yaml" || ! -f "$directory/docker/docker-compose.override.yml" ]]; then
        printf '%s\n' '❌ Missing .config/setup.yaml or docker/docker-compose.override.yml. Run ./lamp docker-setup first.' >&2
        exit 1
    fi
    chmod 700 "$LAMP_CONFIG_DIR"
    data_repository=$(configured_data_repository)
    # without a data repository the .data folder is mounted at /etc/lamp
    if [[ -z "$data_repository" ]]; then compose+=(-f "$directory/docker/docker-compose.data.yml"); fi
fi
# environments belong to www-data while harnesses run as root on the host
if [[ "$command" = start || "$command" = add ]] && ! git config --global --get-all safe.directory | grep -qx '\*'; then
    git config --global --add safe.directory '*'
fi
# commands that change the container as a whole run alone; work on environments runs side by side and is
# ordered inside the container (control.lock for shared state, one lock per environment)
lock_identity=$(printf '%s' "$directory" | sha256sum)
lock_file="/tmp/lamp-${lock_identity%% *}.lock"
case "$command" in
    docker-build|docker-reset|start|restart|stop)
        exec 9>> "$lock_file"
        flock 9
        ;;
    build|syncdb|add|remove|reset)
        exec 9>> "$lock_file"
        flock --shared 9
        ;;
esac
case "$command" in
    docker-build|start|restart|stop)
        container_state=$("${compose[@]}" ps --all --format '{{.State}}' app)
        case "$container_state" in
            running|restarting|paused)
                if [[ "$command" != stop && "$command" != restart ]]; then
                    printf '❌ Cannot %s: LAMP is already active. Run lamp stop first.\n' "$command" >&2
                    exit 1
                fi
                ;;
            ''|created|exited|dead)
                if [[ "$command" = stop ]]; then
                    printf '❌ Cannot stop: LAMP is not running.\n' >&2
                    exit 1
                fi
                ;;
            *) printf '❌ Cannot %s: unexpected LAMP container state (%s).\n' "$command" "$container_state" >&2; exit 1 ;;
        esac
        ;;
esac
if [[ -n "$data_repository" ]]; then
    case "$command" in
        start|restart|cloudflare-setup|build|syncdb|add)
            # parallel commands must not fetch into the same clone at once
            exec 8>> "$lock_file.data"
            flock 8
            sync_data
            flock --unlock 8
            ;;
    esac
fi
if [[ "$command" != docker-reset && -z "$data_repository" ]]; then
    mkdir -p "$directory/.data/ssh" "$directory/.data/syncdb" "$directory/.data/build"
    chmod 700 "$directory/.data" "$directory/.data/ssh" "$directory/.data/syncdb" "$directory/.data/build"
fi
case "$command" in
    docker-build) "${compose[@]}" build --no-cache ;;
    docker-reset) "${compose[@]}" down --volumes --rmi all --remove-orphans ;;
    start|restart)
        if [[ "$command" = restart && "$container_state" = running ]]; then
            "${compose[@]}" exec -T app python3 /opt/lamp/vpn.py validate
            "${compose[@]}" exec -T app python3 /opt/lamp/control.py validate
        fi
        if [[ "$command" = restart ]]; then
            printf '🐳 stopping the container\n'
            "${compose[@]}" stop
        fi
        start_since=$(date -u +%FT%TZ)
        phase=container
        printf '🐳 starting the container: databases, settings, cloudflare tunnel and certificate (a first start takes a few minutes)\n'
        "${compose[@]}" up -d --no-build --wait --wait-timeout 240
        if command -v gh >/dev/null 2>&1 && github_token=$(gh auth token --hostname github.com 2>/dev/null); then
            if printf '%s\n' "$github_token" | "${compose[@]}" exec -T app bash -c 'umask 077; gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --with-token --insecure-storage' >/dev/null 2>&1; then
                printf '🔐 GitHub CLI: using the host authentication\n'
            else
                printf '⚠️ Could not apply the host GitHub CLI authentication.\n' >&2
            fi
        fi
        unset github_token
        printf '🐳 container is healthy, applying .config/env.yaml\n'
        phase=environments
        if [[ -f "$directory/.config/initial-environments" ]]; then
            "${compose[@]}" exec -T app bash /opt/lamp/initial-environments.sh
        else
            "${compose[@]}" exec -T app python3 /opt/lamp/control.py reconcile
        fi
        ;;
    stop) "${compose[@]}" stop ;;
    audit) "${compose[@]}" exec "${tty[@]}" app bash /opt/lamp/audit.sh ;;
    ssh|code)
        container_id=$("${compose[@]}" ps --quiet app)
        container_name=$(docker inspect --format '{{.Name}}' "$container_id")
        code_bridge=(python3 "$directory/docker/scripts/vscode.py" --lamp-host "$directory/.config" "$container_name")
        if [[ "$command" = code ]]; then
            "${code_bridge[@]}" "${compose[@]}" exec -T -e LAMP_CODE_BRIDGE app bash -c 'cd -- "$1" && code .' bash "$PWD"
        elif [[ "$#" = 1 ]]; then
            shown=$("${compose[@]}" exec -T app python3 /opt/lamp/control.py show "$1") || exit 1
            identity=$(printf '%s' "$shown" | python3 -c 'import json, sys; print(json.load(sys.stdin)["id"])')
            "${code_bridge[@]}" "${compose[@]}" exec -e LAMP_CODE_BRIDGE app bash -c "source /var/lib/lamp/environments/$identity/setup.env && cd \"\$LAMP_PROJECT_DIR\" && [[ -e .git ]] && git status; exec bash -il"
        else
            "${code_bridge[@]}" "${compose[@]}" exec -e LAMP_CODE_BRIDGE app bash -c 'if [[ -d "$1" ]]; then cd -- "$1" || exit; fi; exec bash -il' bash "$PWD"
        fi
        ;;
    cloudflare-setup) "${compose[@]}" --progress quiet run --rm --no-deps -T app python3 /opt/lamp/cloudflare.py setup ;;
    exec)
        if [[ "$#" = 2 ]]; then
            "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py exec "$1" "$2"
        else
            "${compose[@]}" exec "${tty[@]}" app bash -lc "$1"
        fi
        ;;
    curl)
        "${compose[@]}" exec -T app python3 /opt/lamp/curl.py "$@"
        ;;
    syncdb) "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py sync "$@" ;;
    *) "${compose[@]}" exec "${tty[@]}" app python3 /opt/lamp/control.py "$command" "$@" ;;
esac
